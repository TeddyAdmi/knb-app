        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://test.pocketnet.app https://pocketnet.app https://bastyon.com;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
